<!-- Add validation before the Salesforce query -->
<choice doc:name="Validate ContentVersionId" doc:id="NEW-ELEMENT-ID">
    <!-- REPLACE doc:id with UUID -->
    <when expression="#[sizeOf(payload.contentVersionId default []) > 0 and payload.contentVersionId[0] != null and payload.contentVersionId[0] != '']">
        <salesforce:query doc:name="Query" doc:id="0971d651-8d62-4227-a465-459237d002e6" config-ref="Salesforce_Config">
    <salesforce:salesforce-query><![CDATA[
    SELECT Id, DistributionPublicUrl, Name, ContentDownloadUrl FROM ContentDistribution WHERE ContentVersionID = ':insertedFileId'
    ]]></salesforce:salesforce-query>
    <salesforce:parameters><![CDATA[
    #[{
    insertedFileId: ((payload.contentVersionId default [])[0]) default ""
    }]
    ]]></salesforce:parameters>
    </salesforce:query>
    </when>
    <otherwise>
        <logger level="WARN" doc:name="Log Missing ContentVersionId" doc:id="NEW-ELEMENT-ID" message="#['[' ++ correlationId ++ '] ContentVersionId is null or empty - skipping Salesforce query']"/>
        <!-- REPLACE doc:id with UUID -->
        <ee:transform doc:name="Return Empty Result" doc:id="NEW-ELEMENT-ID">
            <!-- REPLACE doc:id with UUID -->
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
[]
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </otherwise>
</choice>